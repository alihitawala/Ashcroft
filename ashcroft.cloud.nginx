server {
    server_name ashcroft.cloud www.ashcroft.cloud;

    # Security headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data: https://upload.wikimedia.org https://crests.football-data.org https://media.formula1.com https://*.espncdn.com https://i.ytimg.com https://i9.ytimg.com https://h.cricapi.com https://g.cricapi.com https://static01.nyt.com https://ichef.bbci.co.uk https://c.ndtvimg.com https://static.toiimg.com https://th-i.thgim.com https://images.indianexpress.com https://www.hindustantimes.com https://media.npr.org https://d.newsweek.com https://*.pbs.org" always;

    # Hide nginx version
    server_tokens off;

    # Allow photo uploads up to 50MB
    client_max_body_size 50m;

    # Static files root
    root /home/ashcroft/www/public;

    # Mocks (design review)
    location /mocks/ {
        try_files $uri $uri/ =404;
    }

    # Data JSON (cached by server-side cron, short browser cache)
    location /data/ {
        add_header Cache-Control "public, max-age=300";
        add_header Access-Control-Allow-Origin "*";
        try_files $uri =404;
    }

    # API proxy to Node.js backend
    location /api/ {
        proxy_pass http://127.0.0.1:3456;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # App pages (login, dashboard, tasks, etc.) — served from /app/
    location /app/ {
        alias /home/ashcroft/www/app/;
        try_files $uri $uri/ /app/index.html;
    }

    # Main page — serve the public homepage
    location = / {
        rewrite ^ /mocks/public-home.html last;
    }

    # Fallback
    location / {
        try_files $uri $uri/ =404;
    }

    listen [::]:443 ssl ipv6only=on;
    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/ashcroft.cloud/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ashcroft.cloud/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    if ($host = www.ashcroft.cloud) {
        return 301 https://$host$request_uri;
    }

    if ($host = ashcroft.cloud) {
        return 301 https://$host$request_uri;
    }

    listen 80;
    listen [::]:80;
    server_name ashcroft.cloud www.ashcroft.cloud;
    return 404;
}
