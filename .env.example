# Copy this to .env and fill in your values
JWT_SECRET=your-jwt-secret-here
CRICAPI_KEY=your-cricapi-key
YOUTUBE_API_KEY=your-youtube-api-key

# Amadeus Flight API
AMADEUS_TEST_API_KEY=your-amadeus-test-key
AMADEUS_TEST_API_SECRET=your-amadeus-test-secret
AMADEUS_ENV=test

# Iftar/Event reminder emails
REMINDER_EMAIL_USER=your-email@gmail.com
REMINDER_EMAIL_PASS=your-gmail-app-password
